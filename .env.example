# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file — it is listed in .gitignore.

# Port the demo server listens on
PORT=3000

# development | production
NODE_ENV=development

# Where the JSON demo data layer stores its database file
DATA_DIR=./data

# Demo wallet balance given to brand-new accounts (sandbox money only)
STARTING_BALANCE=1000.00

# Maximum single demo top-up amount
MAX_TOPUP=1000000.00
