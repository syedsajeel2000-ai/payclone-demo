# Copy this file to .env and adjust values for your environment.
# NEVER commit the real .env file — it is listed in .gitignore.

# Port the demo server listens on
PORT=3000

# development | production
NODE_ENV=development

# Where the demo database stores its files (SQLite db + WAL)
DATA_DIR=./data
# (SQLite is the default engine via Node's built-in node:sqlite — no setup
#  needed. An existing data/db.json is auto-imported on first boot.)

# Demo wallet balance given to brand-new accounts (sandbox money only)
STARTING_BALANCE=1000.00

# Maximum single demo top-up amount
MAX_TOPUP=1000000.00

# ---- Remote database (Upstash Redis) — optional, only needed on hosts with an
# ---- ephemeral filesystem (e.g. Vercel serverless) ----
# Without these, the demo stores data in a local JSON file; on Vercel's
# read-only filesystem that falls back to /tmp, which is EPHEMERAL (wiped on
# every cold-start — accounts and logins will not survive). With Redis set
# (and NODE_ENV=production), every account, session and transaction persists.
# Create a free database at https://console.upstash.com → REST → copy both values.
# Also set them in Vercel: Project → Settings → Environment Variables.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
# Optional: change the key the snapshot is stored under (default payclone:demo:db)
# REDIS_DB_KEY=payclone:demo:db
